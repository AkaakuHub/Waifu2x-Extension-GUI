	@test -d Waifu2x-Extension-GUI.app/Contents/Resources || mkdir -p Waifu2x-Extension-GUI.app/Contents/Resources
	@touch Waifu2x-Extension-GUI.app/Contents/Resources/empty.lproj
	
Waifu2x-Extension-GUI.app/Contents/Info.plist: 
	@test -d Waifu2x-Extension-GUI.app/Contents || mkdir -p Waifu2x-Extension-GUI.app/Contents
	@$(DEL_FILE) Waifu2x-Extension-GUI.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,org.gomamayo.Waifu2x-Extension-GUI,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},org.gomamayo.Waifu2x-Extension-GUI,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,icon_main.icns,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},icon_main.icns,g" -e "s,@EXECUTABLE@,Waifu2x-Extension-GUI,g" -e "s,@LIBRARY@,Waifu2x-Extension-GUI,g" -e "s,\$${EXECUTABLE_NAME},Waifu2x-Extension-GUI,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang/Info.plist.app >Waifu2x-Extension-GUI.app/Contents/Info.plist
