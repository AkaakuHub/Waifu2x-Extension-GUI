####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Waifu2x-Extension-GUI/bin || mkdir -p $(INSTALL_ROOT)/opt/Waifu2x-Extension-GUI/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Waifu2x-Extension-GUI/bin/Waifu2x-Extension-GUI.app
	
	$(QINSTALL) Waifu2x-Extension-GUI.app $(INSTALL_ROOT)/opt/Waifu2x-Extension-GUI/bin/Waifu2x-Extension-GUI.app
	-$(STRIP) $(INSTALL_ROOT)/opt/Waifu2x-Extension-GUI/bin/Waifu2x-Extension-GUI.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Waifu2x-Extension-GUI/bin/Waifu2x-Extension-GUI.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Waifu2x-Extension-GUI/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

