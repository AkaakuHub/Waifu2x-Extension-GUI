Waifu2x-Extension-GUI.app/Contents/PkgInfo: 
	@test -d Waifu2x-Extension-GUI.app/Contents || mkdir -p Waifu2x-Extension-GUI.app/Contents
	@$(DEL_FILE) Waifu2x-Extension-GUI.app/Contents/PkgInfo
	@echo "APPL????" > Waifu2x-Extension-GUI.app/Contents/PkgInfo
Waifu2x-Extension-GUI.app/Contents/Info.plist: 
	@test -d Waifu2x-Extension-GUI.app/Contents || mkdir -p Waifu2x-Extension-GUI.app/Contents
	@$(DEL_FILE) Waifu2x-Extension-GUI.app/Contents/Info.plist
